{
  "name": "joget-analyzer-web",
  "version": "1.0.0",
  "private": true,
  "description": "Joget .jwa アプリ解析 Web ツール：事実は解析で（Node.js）、設計書 / 影響分析 / 呼び出し関係図 / RAG チャンクを出力",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite build && node server.js",
    "verify:lang": "python3 verify/check_japanese_only.py",
    "test:ui": "node test-ui.mjs",
    "test:engine": "node test-engine.js",
    "test:mermaid": "node test-mermaid.mjs",
    "test:plugin": "node test-plugin.js",
    "test:correlate": "node test-correlate.js",
    "test:object-model": "node test-object-model.mjs",
    "test:all": "node test-all.mjs",
    "test:dev": "node test-dev-transform.mjs"
  },
  "dependencies": {
    "adm-zip": "^0.5.14",
    "express": "^4.19.2",
    "fast-xml-parser": "^4.4.1",
    "mermaid": "^10.9.1",
    "multer": "^1.4.5-lts.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@vitejs/plugin-react": "^4.3.1",
    "playwright-core": "^1.64.0",
    "tailwindcss": "^4.0.0",
    "vite": "^5.4.0"
  }
